{
  "name": "SqliteManager",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/SqliteManager",
 "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "additionalVersions": "8.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "remoteEnv": {
    // Test-only SQL-auth path (PLAN.md §11). Never valid in a .sqlmproj, never surfaced in the UI.
    // The real Windows-SSO handshake cannot be exercised from Linux - see .devcontainer/README.md.
    "SQLM_TEST_MSSQL": "Server=mssql,1433;Database=master;User Id=sa;Password=${localEnv:MSSQL_SA_PASSWORD:Dev_Passw0rd_local};Encrypt=False;TrustServerCertificate=True;Connect Timeout=30",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },

  "forwardPorts": [1433, 5173],
  "portsAttributes": {
    "1433": { "label": "SQL Server", "onAutoForward": "silent" },
    "5173": { "label": "Vite dev server", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-mssql.mssql",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "dotnet.defaultSolution": "SqliteManager.sln",
        "editor.formatOnSave": true
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
